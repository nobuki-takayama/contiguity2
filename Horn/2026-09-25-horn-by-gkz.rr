def set_A(A) {
/* usage: gkz_natural_params(A,B)
  H_A(b) が入力
  戻り値 は list
  0: [[a1, b での表現],[a2, b での表現], ....]
  1: [[dx1, Euler op],[dx2, Euler op], ...]
  2: classical HG の独立変数.
  3: 4 に対応する toric ideal の元.
  4: [classical HG(文字列), classical HG(文字列), ....]
  5: 2 を展開した classical HG の微分作用素のリスト.
*/
  H_A=A;
  H_d=length(A); H_n=length(A[0]);
  H_gkz_xvar=base_var_list(x,1,H_n);
  H_beta=Beta=base_var_list(b,1,H_d);
  H_gkz=sm1.gkz([H_A,H_beta]);
  H_a=base_var_list(a,1,H_d);  // ABC に対応. Horn 変数.
  T=gkz_natural_params(A,Beta);
  H_set_A_data=T;
  H_a_rule=T[0];
  H_horn_xvar=T[2];
  H_horn_str=T[4];
  H_horn=T[5];
  H_horn_str2=T[6];
  H_b_rule=my_solve_rule(H_a_rule,Beta);

  yang.define_ring(["partial",H_horn_xvar]);
  DV=poly_dvar(H_horn_xvar);
  G=H_horn;  
  G2=map(dp_ptod,G,DV);
  H_horn_gb=yang.buchberger(G2);  

  return T;
}

def show_globals() {
  S="";
  S += sprintf("A matrix (H_A)=\n%a\n",matrix_list_to_matrix(H_A));  // A matrix
  S += sprintf("A is %a * %a matrix.\n",H_d,H_n); // A is H_d * H_n matrix
  S += sprintf("GKZ parameter (H_beta)=%a\n",H_beta);  // parameter beta for GKZ.
  S += sprintf("GKZ x variables (H_gkz_xvar)=%a\n",H_gkz_xvar);  // variable of GKZ
  S += sprintf("GKZ system (H_gkz)=%a\n",H_gkz);       // gkz system
  S += sprintf("------------------------\n");
  S += sprintf("Horn system (H_horn_str)=\n");
  for (I=0; I<length(H_horn_str); I++) {
    S += sprintf(" %a\n",H_horn_str[I]);
  }
  S += sprintf("Horn sytem is stored in H_horn\n");   // Horn type eq
  S += sprintf("Horn sytem xvar(H_horn_xvar) = %a\n",H_horn_xvar); // variable of Horn
  S += sprintf("Horn system parameter (H_a) = %a\n",H_a);     // parameter a for Horn. ABCに対応.
  S += sprintf("a parameter expressed by beta (H_a_rule)=%a\n",H_a_rule); // [[a1, b での表現],[a2, b での表現], ....]
  S += sprintf("beta parameter expressed by a (H_b_rule)=%a\n",H_b_rule); // [[b1, a での表現],[b2, a での表現],....]
  S += sprintf("Other globals:\n");
  S += sprintf("   H_horn_str2=%a\n",H_horn_str2);
  S += sprintf("   H_set_A_data = gkz_natural_params return value\n");
  S += sprintf("   H_horn_gb (GB of Horn)\n");
  S += sprintf("   Horn_contiguity\n");
  S += sprintf("------------------------------\n");
  return S;
}

/*
  Beta は変数のリスト.
  Rule は [[a1,Beta変数のlinearな式1],[a2,Beta変数のlinearな式2], ...]
  このとき Rule と Beta を与えて
  a1-(Beta変数のlinearな式1)=0, a2-(Beta変数のlinearな式2), ... を解く関数 solve_rule(Rule,Beta)を作れ.
  なお一次方程式系は
  poly_solve_linear(一次方程式のリスト,Beta) 
  で解くことができる. --> gemini
*/
def my_solve_rule(Rule, Beta) {
    Eqs = [];
    for (I = 0; I < length(Rule); I++) {
        /* Rule[I][0] = a_i, Rule[I][1] = expr_i */
        /* a_i - expr_i = 0 の形にするため多項式の減算を行う */
        Eqs = cons(Rule[I][0] - Rule[I][1], Eqs);
    }
    /* consで先頭に追加していったため、リストの順序を元に戻す */
    Eqs = reverse(Eqs);
    
    /* 連立一次方程式を解く */
    Ans = poly_solve_linear(Eqs, Beta);
    
    return Ans;
}

