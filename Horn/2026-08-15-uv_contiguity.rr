    Cont=[4*b1^2+(-4*b2-2)*b1+b2^2+b2,(-4*x1*x3+x2^2)*dx3+(4*b1-2)*x1],Dxu=dx1,Id=[x3*dx3+x2*dx2+x1*dx1-b1,2*x3*dx3+x2*dx2-b2,-dx1*dx3+dx2^2],Xvar=[x1,x2,x3]
    check_uv_contiguity: OK.

  Return: [4*b1^2+(-4*b2-2)*b1+b2^2+b2,(-4*x1*x3+x2^2)*dx3+(4*b1-2)*x1,x1,x2,x3]

  -----------------------
  tk_chi_to_uv(A,Chi);
