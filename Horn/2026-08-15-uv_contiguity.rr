// 2026.08.15
Xm_noX=1;;
def tk_v_to_monomial(Vdx,U) {
  M=1;
  for (I=0; I<length(Vdx); I++) {
    M=M*Vdx[I]^U[I];
  }
  return M;
}
def tk_append_all(L) {
  All=[];
  for (I=0; I<length(L); I++) {
    All=append(All,L[I]);
  }
  return All;
}

// --- 新規追加: 指定した変数を最小にする Block order 行列を生成 ---
/*
  Saito (2001) Algorithm 4.2 のための完全なブロック順序行列生成
  指定: "最後の変数を最小とし、残りの変数は Grevlex とする"
*/
def tk_elimination_matrix(N_total) {
    local M, I, J;
    M = newmat(N_total, N_total);
    
    // --- ブロック1: 前半の N_total - 1 個の変数に対する Grevlex ---
    // 第0行: 最後の変数"以外"の全次数
    for (J = 0; J < N_total - 1; J++) {
        M[0][J] = 1;
    }
    
    // 第1行 〜 N_total - 2 行: Grevlex のタイブレーク (後ろの変数から優先して -1 を置く)
    for (I = 1; I < N_total - 1; I++) {
        M[I][(N_total - 1) - I] = -1;
    }
    
    // --- ブロック2: 最後の変数 (最小とする変数) ---
    // 第 N_total - 1 行: 前半の変数が完全に一致した場合のみ、最後の変数の次数で比較
    M[N_total - 1][N_total - 1] = 1;
    
    return M;
}

// --- 新規追加: 多項式が斉次 (homogeneous) であるか判定する ---
def tk_is_homogeneous(Poly, Vlist) {
    local Dp_poly, Deg, E, I, Sum;
    if (Poly == 0) return 1;
    
    Dp_poly = dp_ptod(Poly, Vlist);
    if (Dp_poly == 0) return 1;
    
    // 先頭項の全次数を計算
    E = dp_etov(dp_ht(Dp_poly));
    Deg = 0;
    for (I = 0; I < length(E); I++) Deg = Deg + E[I];
    
    Dp_poly = dp_rest(Dp_poly);
    // 残りの全項の次数が一致するかチェック
    while (Dp_poly != 0) {
        E = dp_etov(dp_ht(Dp_poly));
        Sum = 0;
        for (I = 0; I < length(E); I++) Sum = Sum + E[I];
        if (Sum != Deg) return 0; // 非斉次
        Dp_poly = dp_rest(Dp_poly);
    }
    return 1;
}

// --- 新規追加: イデアル全体が斉次であるか判定する ---
def tk_is_homogeneous_ideal(Ideal, Vlist) {
    local I;
    for (I = 0; I < length(Ideal); I++) {
        if (tk_is_homogeneous(Ideal[I], Vlist) == 0) {
            return 0; // 1つでも非斉次があれば 0 を返す
        }
    }
    return 1;
}

// 2026.08.20
def tk_reverse_lex_mat2(N) {
  Mat=newmat(2*N+1,2*N);
  for (I=0; I<2*N; I++) {
    Mat[I][2*N-1-I]=-1;
  }
  for (I=0; I<2*N; I++) Mat[2*N][I]=1;
  return Mat;
}

// =====================================================================
// メイン関数: Saito (2001) Algorithm 4.2 (ハイブリッド自動分岐版)  2026.08.17
// =====================================================================
def tk_saito_algo_4_2(B_poly, U, V, A_mat, I_A, S_vars, Vx, Vdx) {
    local N_vars, D_vars, Thetas, I, J, Theta_i, Dv;
    local B_theta, E, Vx_perm, Vdx_perm, Vd_perm, Gb, Res_nf, Ord_mat, Is_homo;

    N_vars = length(Vx);
    D_vars = length(S_vars);

    // イデアルの斉次性チェック
    Is_homo = tk_is_homogeneous_ideal(I_A, Vdx);
    if (Is_homo == 1) {
        printf("I_A is homogeneous. Using Block Grevlex order.\n");
        Ord_mat = tk_elimination_matrix(2 * N_vars);
    } else {
        printf("I_A is non-homogeneous. Using reverse lexicographic order. 2026.08.20. \n");
	printf("Warning: it is not well-order. The reduction might not stop. Todo: tangent cone??\n");
//        Ord_mat = 2; // 順序指定 2 は純粋な Lexicographic order
        Ord_mat = tk_reverse_lex_mat2(N_vars); // 順序指定 は reverse lex order 停止性は OK?
    }

    Thetas = newvect(D_vars);
    for (I = 0; I < D_vars; I++) {
        Theta_i = 0;
        for (J = 0; J < N_vars; J++) {
            Theta_i = Theta_i + A_mat[I][J] * Vx[J] * Vdx[J];
        }
        Thetas[I] = Theta_i;
    }

    B_theta = tk_eval_b_theta(B_poly, S_vars, vtol(Thetas), Vx);

    Dv = 1;
    for (I = 0; I < N_vars; I++) {
        if (V[I] > 0) {
            Dv = Dv * Vdx[I]^V[I];
        }
    }
    E = poly_dmul(B_theta, Dv, Vx);

    for (I = 0; I < N_vars; I++) {
        if (U[I] == 0) continue;

        Vx_perm = tk_put_last(Vx, I);
        Vdx_perm = tk_put_last(Vdx, I);
        Vd_perm = append(Vx_perm, Vdx_perm);

	Ord_orig=dp_ord();
	dp_ord(Ord_mat);
	printf("Vd_perm=%a\n",Vd_perm);
	printf("I_A=%a\n",map(dp_ptod,I_A,Vdx_perm));
        Gb = nd_weyl_gr(I_A, Vd_perm, 0, Ord_mat);
//	printf("tk_p_weyl_true_nf(%a,%a,%a,Ord_mat_list=%a);\n",E,Gb,Vd_perm,matrix_matrix_to_list(Ord_mat));
        Res_nf = tk_p_weyl_true_nf(E, Gb, Vd_perm, Ord_mat);
	dp_ord(Ord_orig); 
        
        if (Res_nf[1] != 1) {
            E = Res_nf[0] / Res_nf[1];
        } else {
            E = Res_nf[0];
        }

        E = tk_right_exact_div_dx(E, Vdx_perm[N_vars - 1], U[I], Vd_perm);
    }
    return E;
}
// =====================================================================
// メイン関数: Saito (2001) Algorithm 4.2 (ブロック順序行列対応版)
// =====================================================================
def tk_saito_algo_4_2_orig2(B_poly, U, V, A_mat, I_A, S_vars, Vx, Vdx) {
    local N_vars, D_vars, Thetas, I, J, Theta_i, Dv;
    local B_theta, E, Vx_perm, Vdx_perm, Vd_perm, Gb, Res_nf, Ord_mat;

    printf("tk_saito_algo_4_2 block order version.\n");
    N_vars = length(Vx);
    D_vars = length(S_vars);

    Thetas = newvect(D_vars);
    for (I = 0; I < D_vars; I++) {
        Theta_i = 0;
        for (J = 0; J < N_vars; J++) {
            Theta_i = Theta_i + A_mat[I][J] * Vx[J] * Vdx[J];
        }
        Thetas[I] = Theta_i;
    }

    B_theta = tk_eval_b_theta(B_poly, S_vars, vtol(Thetas), Vx);

    Dv = 1;
    for (I = 0; I < N_vars; I++) {
        if (V[I] > 0) {
            Dv = Dv * Vdx[I]^V[I];
        }
    }
    E = poly_dmul(B_theta, Dv, Vx);

    // ブロック順序行列の生成 (2 * N_vars 変数用)
    Ord_mat = tk_elimination_matrix(2 * N_vars);

    for (I = 0; I < N_vars; I++) {
        if (U[I] == 0) continue;

        Vx_perm = tk_put_last(Vx, I);
        Vdx_perm = tk_put_last(Vdx, I);
        Vd_perm = append(Vx_perm, Vdx_perm);

        // 順序に行列 Ord_mat を指定して確実な elimination を行う
	Ord_orig=dp_ord(); dp_ord(Ord_mat);
	printf("Vd_perm=%a\n",Vd_perm);
	printf("I_A=%a\n",map(dp_ptod,I_A,Vdx_perm));
        Gb = nd_weyl_gr(I_A, Vd_perm, 0, Ord_mat);
        Res_nf = tk_p_weyl_true_nf(E, Gb, Vd_perm, Ord_mat);
	dp_ord(Ord_orig);
        
        if (Res_nf[1] != 1) {
            E = Res_nf[0] / Res_nf[1]; // 分母が定数なら許容
        } else {
            E = Res_nf[0];
        }

        E = tk_right_exact_div_dx(E, Vdx_perm[N_vars - 1], U[I], Vd_perm);
    }
    return E;
}

// --- 修正版: 正しい modulo D I_A でのゼロ判定検証関数 ---  2026.08.17
def check_symalg_correct(A, E_ans, B_poly, U, V, S_vars, Vx, Vdx) {
    local DD, NN, I, J, Thetas, B_theta, Du, Dv, Diff, Gb_A, Diff_nf, Vall;
    
    A = matrix_matrix_to_list(A);
    DD = length(A); NN = length(A[0]);
    
    // s_i を \theta_i に完全に展開
    Thetas = newvect(DD);
    for (I = 0; I < DD; I++) {
        Thetas[I] = 0;
        for (J = 0; J < NN; J++) {
            Thetas[I] = Thetas[I] + A[I][J] * Vx[J] * Vdx[J];
        }
    }
    B_theta = tk_eval_b_theta(B_poly, S_vars, vtol(Thetas), Vx);
    
    Du = tk_v_to_monomial(Vdx, U);
    Dv = tk_v_to_monomial(Vdx, V);
    
    // s_i を含まない純粋な Weyl 代数上での Diff
    Diff = poly_dmul(E_ans, Du, Vx) - poly_dmul(B_theta, Dv, Vx);
    
    Vall = append(Vx, Vdx);
    // 純粋な I_A で簡約
    Gb_A = nd_weyl_gr(poly_toric_ideal(A, Vdx | quiet=1), Vall, 0, 0);
    Diff_nf = tk_p_weyl_true_nf(Diff, Gb_A, Vall, 0);
    
    if (Diff_nf[0] == 0) {
        printf("check_symalg_correct: PASSED\n");
        return 1;
    } else {
        printf("check_symalg_correct: FAILED\nDiff_nf = %a\n", Diff_nf); debug();
        return 0;
    }
}

def check_symalg(A,E,Bf,U,V) {
  A=matrix_matrix_to_list(A);
  DD=length(A); NN=length(A[0]);
  S=base_var_list(s,1,DD);
  F=sm1.gkz([A,S]); Vx=F[1]; F=F[0]; Vdx=poly_dvar(Vx);
  //Vx=base_var_list(x,1,NN); Vdx=poly_dvar(Vx); F=poly_toric_ideal(A,Vdx);
  return check_symalg_correct(A, E, Bf, U, V, S, Vx, Vdx); // 2026.08.17

  Du=tk_v_to_monomial(Vdx,U);
  Dv=tk_v_to_monomial(Vdx,V);
  if (Contiguity_verbose) printf("E=%a * Du=%a ~ Bf=%a * Dv=%a\n",E,Du,fctr(Bf),Dv);
  Diff=poly_dmul(E,Du,Vx)-Bf*Dv;
  if (Contiguity_verbose) printf("Diff=%a\n",Diff);
  Ord_orig=dp_ord();
  dp_ord(0);
  dp_gr_print(1);
  G=nd_weyl_gr(F,Vall=tk_append_all([S,Vx,poly_dvar(S),Vdx]),0,0);
  //G=nd_weyl_gr(F,Vall=tk_append_all([Vx,Vdx]),0,0);
  if (Contiguity_verbose) printf("G=%a\n",G);
  Diff_nf=tk_p_weyl_true_nf(Diff,G,Vall,0);
  printf("Diff_nf=%a\n",Diff_nf);
  dp_ord(Ord_orig);
  if (Diff_nf[0]==0) {
    printf("check_symalg: PASSED\n");
    return 1;
  }else{
    printf("check_symalg: FAILED\n\n"); debug();
    return 0;
  }
}

def check_symalg_with_beta(A,E,Bf,U,V,Beta,Beta_var) {
  if (type(getopt(prob))>0) Prob=1; else Prob=0;
  if (Prob) {
    printf("check_symalg_with_beta is performed by probabilistic checking...\n");
    printf("Beta_var=%a\n",Beta_var);
    Rule_Beta_var=[];
    for (I=0; I<length(Beta_var); I++) {
      Rule_Beta_var=cons([Beta_var[I],random()%17],Rule_Beta_var);
    }
    Rule_Beta_var=reverse(Rule_Beta_var);
    printf("Rule_Beta_var=%a\n",Rule_Beta_var);
    Beta=base_replace(Beta,Rule_Beta_var);  // Beta を数に.
  }
  A=matrix_matrix_to_list(A);
  DD=length(A); NN=length(A[0]);
  S=base_var_list(s,1,DD);
  F=sm1.gkz([A,S]);
  Vx=F[1]; 

  Rule=assoc(S,Beta);
  F=base_replace(F[0],Rule);
  E=base_replace(E,Rule);
  Bf=base_replace(Bf,Rule);

  Vdx=poly_dvar(Vx);
  Du=tk_v_to_monomial(Vdx,U);
  Dv=tk_v_to_monomial(Vdx,V);
  if (Contiguity_verbose) printf("E=%a * Du=%a ~ Bf=%a * Dv=%a\n",E,Du,fctr(Bf),Dv);
  Diff=poly_dmul(E,Du,Vx)-Bf*Dv;
  Ord_orig=dp_ord();
  dp_ord(0);
  dp_gr_print(1);
  G=nd_weyl_gr(F,Vall=tk_append_all([Beta_var,Vx,poly_dvar(Beta_var),Vdx]),0,0);
  Diff_nf=tk_p_weyl_true_nf(Diff,G,Vall,0);
  printf("Diff_nf=%a\n",Diff_nf);
  dp_ord(Ord_orig);
  if (Diff_nf[0]==0) {
    printf("check_symalg_with_beta: PASSED\n");
    return 1;
  }else{
    printf("check_symalg_with_beta: FAILED\n\n"); printf("Todo: correct version has not yet written.\n"); // Todo, see check_symalg.
    return 0;
  }
}

