////2026-08-14-monomial-part.rr より.

/* 2026-08-10-monomial-part.rr の一般化版.
//Ref: 2026-08-03-banana-contiguity.goodnotes の 8/14
*/

/*
  一般の \chi = AU - AV に対する M_\chi の完全な計算アルゴリズム
  (二項式関係を用いたモノミアル・コアの反復抽出)
  再帰多項式と分散多項式の厳格な区別対応版
*/

// --- 補助関数: 指数ベクトルから単項式を生成 ---
def tk_vec_to_monomial(Vec, Vdx) {
    local Res, I;
    Res = 1;
    for (I = 0; I < length(Vec); I++) {
        if (Vec[I] > 0) {
            Res = Res * Vdx[I]^Vec[I];
        }
    }
    return Res;
}

// --- 補助関数: 二項式から2つの項 (T1, T2) を純粋な再帰多項式として取り出す ---
def tk_get_terms_of_binomial(Poly, Vlist) {
    local Dp_poly, T1_dp, T2_dp, T1, T2;
    if (Poly == 0) return [0, 0];
    
    Dp_poly = dp_ptod(Poly, Vlist);
    if (Dp_poly == 0) return [0, 0];
    
    T1_dp = dp_vtoe(dp_etov(dp_ht(Dp_poly)));
    T1 = dp_dtop(T1_dp, Vlist); // 確実に再帰多項式に戻す
    
    Dp_poly = dp_rest(Dp_poly);
    if (Dp_poly == 0) return [T1, 0];
    
    T2_dp = dp_vtoe(dp_etov(dp_ht(Dp_poly)));
    T2 = dp_dtop(T2_dp, Vlist); // 確実に再帰多項式に戻す
    
    return [T1, T2];
}

// --- 補助関数: M1 / gcd(M1, M2) を正確に計算 (指数の引き算) ---
// 入力・出力ともに再帰多項式
def tk_monomial_div_gcd(M1, M2, Vlist) {
    local Dp1, Dp2, E1, E2, Res, I;
    if (M1 == 0 || M2 == 0) return 0;
    
    Dp1 = dp_ptod(M1, Vlist);
    Dp2 = dp_ptod(M2, Vlist);
    if (Dp1 == 0 || Dp2 == 0) return 0;
    
    E1 = dp_etov(dp_ht(Dp1));
    E2 = dp_etov(dp_ht(Dp2));
    
    Res = 1;
    for (I = 0; I < length(E1); I++) {
        if (E1[I] > E2[I]) {
            Res = Res * Vlist[I]^(E1[I] - E2[I]);
        }
    }
    return Res;
}

// --- 補助関数: 単項式 M が リスト M_list のいずれかで割り切れるか判定 ---
def tk_is_divisible_by_any(M, M_list, Vlist) {
    local Dp_m, Dp_l, E_m, E_l, I, J, Divides;
    if (M == 0) return 1; // 0 は何でも割り切れるとみなして除外
    
    Dp_m = dp_ptod(M, Vlist);
    if (Dp_m == 0) return 1;
    E_m = dp_etov(dp_ht(Dp_m));
    
    for (I = 0; I < length(M_list); I++) {
        if (M_list[I] == 0) continue;
        Dp_l = dp_ptod(M_list[I], Vlist);
        if (Dp_l == 0) continue;
        
        E_l = dp_etov(dp_ht(Dp_l));
        Divides = 1;
        for (J = 0; J < length(E_m); J++) {
            if (E_l[J] > E_m[J]) {
                Divides = 0;
                break;
            }
        }
        if (Divides == 1) {
            return 1;
        }
    }
    return 0;
}

// --- 補助関数: 単項式イデアルの極小生成系への簡約 ---
def tk_minimize_monomial_ideal(M_gens, Vlist) {
    local Res, I, J, Is_divisible, Dp_i, Dp_j, E_i, E_j, Divides, Cmp, K;
    Res = [];
    for (I = 0; I < length(M_gens); I++) {
        if (M_gens[I] == 0) continue;
        Dp_i = dp_ptod(M_gens[I], Vlist);
        if (Dp_i == 0) continue;
        E_i = dp_etov(dp_ht(Dp_i));
        
        Is_divisible = 0;
        for (J = 0; J < length(M_gens); J++) {
            if (I == J || M_gens[J] == 0) continue;
            Dp_j = dp_ptod(M_gens[J], Vlist);
            if (Dp_j == 0) continue;
            E_j = dp_etov(dp_ht(Dp_j));
            
            Divides = 1;
            Cmp = 0;
            for (K = 0; K < length(E_i); K++) {
                if (E_j[K] > E_i[K]) {
                    Divides = 0;
                    break;
                }
                if (E_j[K] < E_i[K]) {
                    Cmp = 1;
                }
            }
            if (Divides == 1) {
                if (Cmp == 1) {
                    Is_divisible = 1; break;
                } else {
                    if (I > J) {
                        Is_divisible = 1; break;
                    }
                }
            }
        }
        if (Is_divisible == 0) {
            Res = cons(M_gens[I], Res);
        }
    }
    return reverse(Res);
}

// =====================================================================
// メイン関数: 一般の \chi に対する M_\chi の完全計算 (反復アルゴリズム)
// 入力: I_A (トーリックイデアル), U_vec (\chi_+), V_vec (\chi_-)
// =====================================================================
def tk_compute_M_chi_general(I_A, U_vec, V_vec, Vdx) {
    local Gb_A, B_list, I, Terms, Dx_u, Dx_v, M_list, Changed, M_next;
    local M, J, B, T1, T2, M_new1, M_new2, Ans;
    
    // 1. I_A のグレブナー基底から二項式の関係をすべて抽出
    Gb_A = nd_gr(I_A, Vdx, 0, 0);
    B_list = [];
    for (I = 0; I < length(Gb_A); I++) {
        Terms = tk_get_terms_of_binomial(Gb_A[I], Vdx);
        if (Terms[1] != 0) {
            B_list = cons(Terms, B_list);
        }
    }
    
    Dx_u = tk_vec_to_monomial(U_vec, Vdx);
    Dx_v = tk_vec_to_monomial(V_vec, Vdx);
    
    // 2. モノミアル・コアの反復抽出 (イテレーション)
    M_list = [ Dx_u ];
    Changed = 1;
    while (Changed == 1) {
        Changed = 0;
        M_next = M_list;
        for (I = 0; I < length(M_list); I++) {
            M = M_list[I];
            if (M == 0) continue;
            for (J = 0; J < length(B_list); J++) {
                B = B_list[J];
                T1 = B[0];
                T2 = B[1];
                
                // M と T1 の関係から新しい単項式 M_new1 を生成
                if (T1 != 0) {
                    M_new1 = T2 * tk_monomial_div_gcd(M, T1, Vdx);
                    if (M_new1 != 0 && tk_is_divisible_by_any(M_new1, M_next, Vdx) == 0) {
                        M_next = cons(M_new1, M_next);
                        M_next = tk_minimize_monomial_ideal(M_next, Vdx);
                        Changed = 1;
                    }
                }
                
                // M と T2 の関係から新しい単項式 M_new2 を生成
                if (T2 != 0) {
                    M_new2 = T1 * tk_monomial_div_gcd(M, T2, Vdx);
                    if (M_new2 != 0 && tk_is_divisible_by_any(M_new2, M_next, Vdx) == 0) {
                        M_next = cons(M_new2, M_next);
                        M_next = tk_minimize_monomial_ideal(M_next, Vdx);
                        Changed = 1;
                    }
                }
            }
        }
        M_list = M_next;
    }
    
    // 3. 抽出された全単項式を \partial^V でイデアル商をとる
    Ans = [];
    for (I = 0; I < length(M_list); I++) {
        Ans = cons(tk_monomial_div_gcd(M_list[I], Dx_v, Vdx), Ans);
    }
    
    // 4. 最終的な極小生成系にして返す
    return tk_minimize_monomial_ideal(Ans, Vdx);
}

////2026-08-11-b-ideal.rr より
/*
  b-ideal B_\chi を計算するアルゴリズム (Proposition 4.3 + 消去法)
*/

// --- 補助関数: モノミアル \partial^u から Distraction を計算する ---
def tk_compute_distraction_poly(Monomial, Vdx, Vtheta) {
    local Dp_mon, E_vec, Res, I, K;
    
    Dp_mon = dp_ptod(Monomial, Vdx);
    E_vec = dp_etov(dp_ht(Dp_mon));
    Res = 1;
    
    for (I = 0; I < length(E_vec); I++) {
        if (E_vec[I] > 0) {
            // \theta_I * (\theta_I - 1) * ... * (\theta_I - u_I + 1)
            for (K = 0; K < E_vec[I]; K++) {
                Res = Res * (Vtheta[I] - K);
            }
        }
    }
    return Res;
}

// --- メイン関数: B_\chi の生成元を計算する ---
// 入力: M_chi_gens (M_\chi の生成元のリスト), A_mat (GKZ行列)
// Vdx (\partial 変数), Vtheta (\theta 変数), Vs (s 変数)
def tk_compute_B_chi(M_chi_gens, A_mat, Vdx, Vtheta, Vs) {
    local I, J, N_vars, D_vars, J_ideal, Dist_poly, Def_s, Gb, B_chi, Poly, Has_theta, Pos;
    local V_all;

    N_vars = length(Vdx);
    D_vars = length(Vs);
    J_ideal = [];

    // 1. M_\chi の Distraction を計算してイデアルに追加
    for (I = 0; I < length(M_chi_gens); I++) {
        Dist_poly = tk_compute_distraction_poly(M_chi_gens[I], Vdx, Vtheta);
        J_ideal = cons(Dist_poly, J_ideal);
    }

    // 2. s_i = \sum a_{ij} \theta_j の定義式をイデアルに追加
    for (I = 0; I < D_vars; I++) {
        Def_s = Vs[I];
        for (J = 0; J < N_vars; J++) {
            Def_s = Def_s - A_mat[I][J] * Vtheta[J];
        }
        J_ideal = cons(Def_s, J_ideal);
    }
    J_ideal = reverse(J_ideal);

    // 3. \theta を消去するための変数リスト ( \theta \succ s )
    V_all = append(Vtheta, Vs);

    // 4. 純粋な可換イデアルとして、Lexicographic order (順序指定 2) でグレブナー基底を計算
    printf("Computing Groebner basis for elimination (lex order)...\n");
    Gb = nd_gr(J_ideal, V_all, 0, 2);

    // 5. Gb の中から \theta を含まない多項式 (s のみの多項式) を抽出
    B_chi = [];
    for (I = 0; I < length(Gb); I++) {
        Poly = Gb[I];
	//printf("Gb[%a]=%a\n",I,Gb[I]);
        Has_theta = 0;
        for (J = 0; J < N_vars; J++) {
            //printf("Vtheta[J]=%a, vars(Poly)=%a\n",Vtheta[J],vars(Poly));
            Pos = base_position(Vtheta[J], vars(Poly));
            if (Pos >= 0) {
                Has_theta = 1;
                break;
            }
        }
        if (Has_theta == 0) {
            B_chi = cons(Poly, B_chi);
        }
    }

    return reverse(B_chi);
}

////2026-08-11-symalg.rr より
/*
  NT: S = \sum S_\chi,  k[s] 加群 作用は s_i<--> \sum a_{ij} x_j \pd{j}
  Symmetry Algebra: Algorithm 4.2 の実装
  b \in B_\chi から E \in S_\chi を構成する
*/

// --- 補助関数: リストの特定のインデックスの要素を末尾に移動する ---
def tk_put_last(List, Idx) {
    local Res, I;
    Res = [];
    for (I = 0; I < length(List); I++) {
        if (I != Idx) {
            Res = cons(List[I], Res);
        }
    }
    Res = reverse(Res);
    Res = append(Res, [List[Idx]]);
    return Res;
}

// --- 補助関数: Weyl 代数での K 乗の計算 ---
def tk_weyl_power(Poly, K, Vx) {
    local Res, I;
    Res = 1;
    for (I = 0; I < K; I++) {
        Res = poly_dmul(Res, Poly, Vx);
    }
    return Res;
}

// --- 補助関数: 多項式 b(s) にオイラー作用素 Thetas を非可換積として代入する ---
def tk_eval_b_theta(B_poly, S_vars, Thetas, Vx) {
    local Dp_b, Res, C, E_vec, Term, I;
    Dp_b = dp_ptod(B_poly, S_vars);
    Res = 0;
    
    while (Dp_b != 0) {
        C = dp_hc(Dp_b);
        E_vec = dp_etov(dp_ht(Dp_b));
        Term = C;
        for (I = 0; I < length(S_vars); I++) {
            if (E_vec[I] > 0) {
                Term = poly_dmul(Term, tk_weyl_power(Thetas[I], E_vec[I], Vx), Vx);
            }
        }
        Res = Res + Term;
        Dp_b = dp_rest(Dp_b);
    }
    return Res;
}

// --- 補助関数: Weyl 代数における \partial_i^K による正確な右除算 ---
def tk_right_exact_div_dx(Poly, Dx_var, K, Vd) {
    local Dp_poly, Res, C, E_vec, Term, I, Pos;
    if (Poly == 0) {
        return 0;
    }
    Pos = base_position(Dx_var, Vd);
    Dp_poly = dp_ptod(Poly, Vd);
    Res = 0;
    
    while (Dp_poly != 0) {
        C = dp_hc(Dp_poly);
        E_vec = dp_etov(dp_ht(Dp_poly));
        // 理論上割り切れることが保証されているため、指数を安全に減算
        if (E_vec[Pos] >= K) {
            E_vec[Pos] = E_vec[Pos] - K;
        } else {
            E_vec[Pos] = 0; 
        }
        
        Term = C;
        // 新しい指数ベクトルから標準多項式を復元
        for (I = 0; I < length(Vd); I++) {
            if (E_vec[I] > 0) {
                Term = Term * Vd[I]^E_vec[I];
            }
        }
        Res = Res + Term;
        Dp_poly = dp_rest(Dp_poly);
    }
    return Res;
}


// =====================================================================
// メイン関数: Saito (2001) Algorithm 4.2
// 入力: B_poly (b \in B_\chi), U, V (\chi = Au - Av), A_mat (GKZ行列), I_A
// =====================================================================
def tk_saito_algo_4_2_orig(B_poly, U, V, A_mat, I_A, S_vars, Vx, Vdx) {
    local N_vars, D_vars, Thetas, I, J, Theta_i, Dv;
    local B_theta, E, Vx_perm, Vdx_perm, Vd_perm, Gb, Res_nf;

    N_vars = length(Vx);
    D_vars = length(S_vars);

    // 1. オイラー作用素の構成: Theta_i = sum A_mat[I][J] * Vx[J] * Vdx[J]
    Thetas = newvect(D_vars);
    for (I = 0; I < D_vars; I++) {
        Theta_i = 0;
        for (J = 0; J < N_vars; J++) {
            Theta_i = Theta_i + A_mat[I][J] * Vx[J] * Vdx[J];
        }
        Thetas[I] = Theta_i;
    }

    // 2. b(Theta) の厳密な Weyl 評価
    B_theta = tk_eval_b_theta(B_poly, S_vars, vtol(Thetas), Vx);

    // 3. E = b(Theta) * \partial^v の初期化
    Dv = 1;
    for (I = 0; I < N_vars; I++) {
        if (V[I] > 0) {
            Dv = Dv * Vdx[I]^V[I];
        }
    }
    E = poly_dmul(B_theta, Dv, Vx);

    // 4. Algorithm 4.2 の削減ループ
    for (I = 0; I < N_vars; I++) {
        if (U[I] == 0) {
            continue; // 割る必要がない変数はスキップ
        }

        // \partial_i が最小の変数となるように変数リストを並べ替える
        Vx_perm = tk_put_last(Vx, I);
        Vdx_perm = tk_put_last(Vdx, I);
        Vd_perm = append(Vx_perm, Vdx_perm);

        // 並べ替えた変数で I_A のグレブナー基底を計算
        //Ref: toricが homogeneous でない時は 0 でなく, lex order が必要.
        Ord_42=Tk_UV_ord_42; //2026.08.16 N.T.  lex  cf. 
	printf("Vd_perm=%a, Using order = %a.\n",Vd_perm,Ord_42);
        Gb = nd_weyl_gr(I_A, Vd_perm, 0, Ord_42); //2026.08.16 N.T.  lex for 1F1

        // E を Gb で簡約 (true normal form の分子と分母の商をとる)
        Res_nf = p_true_nf(E, Gb, Vd_perm, Ord_42); dp_ord(0); //2026.08.16 N.T. lex
        E = Res_nf[0] / Res_nf[1];

        // 簡約された E を右から \partial_i^{U[I]} で正確に割り算
        E = tk_right_exact_div_dx(E, Vdx_perm[N_vars - 1], U[I], Vd_perm);
    }

    return E;
}

// === 実行サンプル ===
def tk_example_algo_4_2() {
    local A_mat, U, V_vec, I_A, B_poly, S_vars, Vx, Vdx, E_ans;
    
    A_mat = matrix_list_to_matrix([
        [1, 1, 1, 1],
        [0, 1, 2, 3]
    ]);
    S_vars = [s1, s2];
    Vx = [x1, x2, x3, x4];
    Vdx = [dx1, dx2, dx3, dx4];
    
    I_A = [dx2^2 - dx1*dx3, dx3^2 - dx2*dx4, dx1*dx4 - dx2*dx3];
    
    U = [1, 0, 0, 0];
    V_vec = [0, 1, 0, 0];
    B_poly = s2; // 例としての仮の b-多項式
    
    printf("Executing Saito (2001) Algorithm 4.2...\n");
    E_ans = tk_saito_algo_4_2(B_poly, U, V_vec, A_mat, I_A, S_vars, Vx, Vdx);
    printf("Resulting Symmetry Operator E:\n%a\n", E_ans);
}

