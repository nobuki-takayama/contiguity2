// 2026.09.03
/*
 S(t) で parametrize された affine 空間で b-function を求めると t の関数になる.
 b-function b(t) の linear factor を Bfac とした時, 
 Bfac=0 となる affine 空間の表現(func_contiguity.py 準拠)を求める. 
*/
def bf_factor_to_affine_space(S,Bfac) {
  V=vars(S);
  D=length(S);
  SV=base_var_list(_s,1,D);
  Eq=[Bfac];
  for (I=0; I<D; I++) Eq=cons(SV[I]-S[I],Eq);
  G=poly_elimination_ideal(Eq,SV);
  //printf("G=%a\n",G);
  if ((length(G)==1) && (type(G[0]) < 2)) return [];
  Ans=poly_coefficients_of_monomial_list(G,cons(1,SV));
  return Ans;
}
/*
T0=bf_factor_to_affine_space([t1+t2+1/2,2*t2],t1-t2-1);
T1=bf_factor_to_affine_space([t1+t2+1/2,2*t2,t1],t1-t2-1);
T3=bf_factor_to_affine_space([t1,t2,t3],t1-t2-1);
T4=bf_factor_to_affine_space([t1,t2,t3],1);
T5=bf_factor_to_affine_space([t1+1/2,2*t1,t1],t1-1);
*/

// 2026.09.04
def b_ideal_to_affine_spaces(S,B_ideal) {
  //printf("S=%a, B_ideal=%a\n",S,B_ideal);
  if (vars(B_ideal)==[]) return [];
  if ((length(B_ideal)==1) && (type(B_ideal[0]) < 2)) return [];
  B_ideal=primadec(B_ideal,vars(B_ideal));
  Affine=[];
  V=vars(S);
  D=length(S);
  SV=base_var_list(_s,1,D);
  for (I=0; I<length(B_ideal); I++) {
    Eq=B_ideal[I][1];  // primary component
    for (II=0; II<D; II++) Eq=cons(SV[II]-S[II],Eq);
    G=poly_elimination_ideal(Eq,SV);
    //printf("G=%a\n",G);
    if ((length(G)==1) && (type(G[0]) < 2)) continue;
    Ans=poly_coefficients_of_monomial_list(G,cons(1,SV));
    Affine=cons(Ans,Affine);
  }
  return Affine;
}

