def tk_uv_contiguity(UV,A,Beta) {
  if (type(getopt(b_ideal))>0) return tk_uv_contiguity_v2(UV,A,Beta | option_list=getopt());
  else return tk_uv_contiguity_v1(UV,A,Beta | option_list=getopt());
}
def tk_uv_contiguity_v1(UV,A,Beta) {
  printf("Executing tk_uv_contiguity_v1(UV=%a,A=%a,Beta=%a)\n",UV,A,Beta);
  A=matrix_matrix_to_list(A);
  DD=length(A); NN=length(A[0]);

  A_mat = matrix_list_to_matrix(A);
  S_vars = base_var_list(s,1,DD);
  Vx = base_var_list(x,1,NN);
  Vdx = poly_dvar(Vx);
  I_A=poly_toric_ideal(A,Vdx | quiet=1);
    
  U = UV[0];
  V_vec = UV[1];
//// 2026-08-15-test-symalg.rr を参考に.
  // computing M_\chi,  2026-08-14-monomial-part.rr
  printf("Computing M_chi with iteration for U=%a, V=%a...\n", U, V_vec);
  M_chi_ans = tk_compute_M_chi_general(I_A, U, V_vec, Vdx);
  printf("Generators of M_chi:\n%a\n", M_chi_ans);

  // computing b-ideal B_chi_ans, 2026-08-11-b-ideal.rr
  B_chi_ans = tk_compute_B_chi(M_chi_ans, A, Vdx, Vtheta=base_var_list(t,1,NN), Vs=base_var_list(s,1,DD) | option_list=getopt());
  printf("b-ideal B_chi is %a\n",B_chi_ans);
  if (length(B_chi_ans)>1) printf("Warning! Using only the top element of b-ideal.\n");
  Tk_UV_B_ideal=B_chi_ans;
  B_poly = B_chi_ans[0]; //  b-多項式, 上記 T10 より.

  printf("U=%a, V=%a, B_poly=%a\n",U,V_vec,B_poly);
    
  printf("Executing Saito (2001) Algorithm 4.2...\n");
  E_ans = tk_saito_algo_4_2(B_poly, U, V_vec, A_mat, I_A, S_vars, Vx, Vdx);
  if (Contiguity_verbose) printf("Resulting Symmetry Operator E:\n%a\n", E_ans);

  printf("Checking the result by check_symalg.\n");
  check_symalg(A,E_ans,B_poly,U,V_vec | option_list=getopt());
  printf("---------- Done checking the result of symalg.\n");
  printf("Checking the result by check_symalg_with_beta.\n");
  check_symalg_with_beta(A,E_ans,B_poly,U,V_vec,Beta,vars(Beta) | option_list=getopt());
  printf("---------- Done checking the result of symalg_with_beta.\n");

  Dxv=tk_v_to_monomial(Vdx,V_vec);
  Tk_UV_Bf_E=append([B_poly*Dxv,E_ans],Vx);
  Ans=base_replace(Tk_UV_Bf_E,Rule=assoc(S_vars,Beta));
  printf("assoc(S_vars,Beta)=%a\n",Rule);
  return Ans;
}

/*
  b-ideal が単項生成でないとき list で答えを戻す.
*/
def tk_uv_contiguity_v2(UV,A,Beta) {
  printf("Executing tk_uv_contiguity_v2(UV=%a,A=%a,Beta=%a)\n",UV,A,Beta);
  A=matrix_matrix_to_list(A);
  DD=length(A); NN=length(A[0]);

  A_mat = matrix_list_to_matrix(A);
  S_vars = base_var_list(s,1,DD);
  Vx = base_var_list(x,1,NN);
  Vdx = poly_dvar(Vx);
  I_A=poly_toric_ideal(A,Vdx | quiet=1);
    
  U = UV[0];
  V_vec = UV[1];
//// 2026-08-15-test-symalg.rr を参考に.
  // computing M_\chi,  2026-08-14-monomial-part.rr
  printf("Computing M_chi with iteration for U=%a, V=%a...\n", U, V_vec);
  M_chi_ans = tk_compute_M_chi_general(I_A, U, V_vec, Vdx);
  printf("Generators of M_chi:\n%a\n", M_chi_ans);

  // computing b-ideal B_chi_ans, 2026-08-11-b-ideal.rr
  B_chi_ans = tk_compute_B_chi(M_chi_ans, A, Vdx, Vtheta=base_var_list(t,1,NN), Vs=base_var_list(s,1,DD));
  printf("b-ideal B_chi is %a\n",B_chi_ans);
  Tk_UV_B_ideal=B_chi_ans;

  Ans_all=[];
  for (I=0; I<length(B_chi_ans); I++) {
    B_poly=B_chi_ans[I];
    printf("U=%a, V=%a, B_poly=%a\n",U,V_vec,B_poly);
    
    printf("Executing Saito (2001) Algorithm 4.2...\n");
    E_ans = tk_saito_algo_4_2(B_poly, U, V_vec, A_mat, I_A, S_vars, Vx, Vdx);
    if (Contiguity_verbose) printf("Resulting Symmetry Operator E:\n%a\n", E_ans);

    check_symalg(A,E_ans,B_poly,U,V_vec);
    check_symalg_with_beta(A,E_ans,B_poly,U,V_vec,Beta,vars(Beta));

    Dxv=tk_v_to_monomial(Vdx,V_vec);
    Tk_UV_Bf_E=append([B_poly*Dxv,E_ans],Vx);
    Ans= base_replace(Tk_UV_Bf_E,Rule=assoc(S_vars,Beta));
    printf("I=%a; assoc(S_vars,Beta)=%a\n",I,Rule);
    Ans_all=cons(Ans,Ans_all);
  }
  return reverse(Ans_all);
}

def uv_len(UV) {
  Len=0;
  for (I=0; I<length(UV[0]); I++) {
    Len += number_abs(UV[0][I])+number_abs(UV[1][I]);
  }
  return Len;
}
def tk_chi_to_uv(A,Chi) {
  if (type(getopt(opt))>0) Opt=getopt(opt);
  else Opt=0;
  if (Opt==0) return tk_chi_to_uv_main(A,Chi);
  UV=tk_chi_to_uv_main(A,Chi);
  Chi_minus=vtol(-matrix_list_to_matrix(Chi));
  UV2=tk_chi_to_uv_main(A,Chi_minus);
  UV2=[UV2[1],UV2[0]];
  if (uv_len(UV) > uv_len(UV2)) return UV2;
  else return UV;
}
////2026-08-07-banana-one-loop.rr より
def tk_chi_to_uv_main(A,Chi) {
  Dbeta=matrix_matrix_to_list(Chi);
  HH_A=matrix_matrix_to_list(A);
  HH_d=length(HH_A); HH_n=length(HH_A[0]);

  /* --- 新規追加: 最短のシフトベクトル U, V を探索する --- */
  Found_UV = 0;
  Best_U = newvect(HH_n);
  Best_V = newvect(HH_n);
  /* 1. 長さ 1 のシフトを探索 ( U=e_j または V=e_j ) */
  for (J = 0; J < HH_n; J++) {
    Col = newvect(HH_d);
    for (I = 0; I < HH_d; I++) Col[I] = HH_A[I][J];
        
    Diff1 = 0; Diff2 = 0;
    for (I = 0; I < HH_d; I++) {
      if (Col[I] != Dbeta[I]) Diff1 = 1;
      if (-Col[I] != Dbeta[I]) Diff2 = 1;
    }
    if (Diff1 == 0) { Best_U[J] = 1; Found_UV = 1; break; }
    if (Diff2 == 0) { Best_V[J] = 1; Found_UV = 1; break; }
  }
    
  /* 2. 見つからなければ、長さ 2 のシフトを探索 */
  if (Found_UV == 0) {
    for (J = 0; J < HH_n; J++) {
      for (K = 0; K < HH_n; K++) {
	ColJ = newvect(HH_d); ColK = newvect(HH_d);
	for (I = 0; I < HH_d; I++) { ColJ[I] = HH_A[I][J]; ColK[I] = HH_A[I][K]; }
                
	Diff1 = 0; Diff2 = 0; Diff3 = 0;
	for (I = 0; I < HH_d; I++) {
	  if (ColJ[I] + ColK[I] != Dbeta[I]) Diff1 = 1;
	  if (-ColJ[I] - ColK[I] != Dbeta[I]) Diff2 = 1;
	  if (ColJ[I] - ColK[I] != Dbeta[I]) Diff3 = 1;
	}
	if (Diff1 == 0) { Best_U[J]++; Best_U[K]++; Found_UV = 1; break; }
	if (Diff2 == 0) { Best_V[J]++; Best_V[K]++; Found_UV = 1; break; }
	if (Diff3 == 0) { Best_U[J]++; Best_V[K]++; Found_UV = 1; break; }
      }
      if (Found_UV == 1) break;
    }
  }
    
  /* 3. それでもダメなら poly_solve_linear (フォールバック) */
  if (HH_no_short_uv) Found_UV=0;
  if (Found_UV == 1) {
    U = vtol(Best_U); V = vtol(Best_V);
  } else {
    W_vars = base_var_list(w, 1, HH_n);
    Eqs = [];
    for (I = 0; I < HH_d; I++) {
      Eq = 0;
      for (J = 0; J < HH_n; J++) Eq = Eq + HH_A[I][J] * W_vars[J];
      Eqs = cons(Eq - Dbeta[I], Eqs);
    }
    Eqs = reverse(Eqs);
    Ans = poly_solve_linear(Eqs, W_vars);
    if (Ans == []) error("対応する GKZ のシフトベクトルが見つかりません。");
        
    Subst_rule = assoc(W_vars, vtol(newvect(length(W_vars))));
    W_vals = [];
    for (I = 0; I < length(W_vars); I++) {
      Found = 0;
      for (J = 0; J < length(Ans); J++) {
	if (Ans[J][0] == W_vars[I]) {
	  W_vals = cons(base_replace(Ans[J][1], Subst_rule), W_vals);
	  Found = 1; break;
	}
      }
      if (Found == 0) W_vals = cons(0, W_vals);
    }
    W_vals = reverse(W_vals);
    U = []; V = [];
    for (I = 0; I < length(W_vals); I++) {
      if (W_vals[I] > 0) { U = cons(W_vals[I], U); V = cons(0, V); }
      else { U = cons(0, U); V = cons(-W_vals[I], V); }
    }
    U = reverse(U); V = reverse(V);
  }
  return [U,V];
}
