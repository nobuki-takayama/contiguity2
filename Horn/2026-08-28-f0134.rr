Xm_noX=1;;

extern F0134_A;;
F0134_A=[
       [1, 0, -2, -3],
       [0, 1, 3, 4]
      ];;
// (2,4) 行列なら何でも OK のはず.
//F0134_A=[[1,0,-1,-2],[0,1,2,3]];

def f0134_contiguity(Old,New) { 
  A = F0134_A;
  Amat=matrix_list_to_matrix(A);
  Beta_start=param_to_beta1(Old);  // change here
  Beta_target=param_to_beta1(New); // change here
  Chi=vtol(ltov(Beta_target)-ltov(Beta_start));
  UV=tk_chi_to_uv(A,Chi);
  printf("UV=%a\n",UV);
  Base_Beta=ltov(Beta_start)+Amat*ltov(UV[0]);
  Base_Beta=vtol(Base_Beta);
  T0=tk_uv_contiguity(UV,A,Base_Beta | option_list=getopt());
  printf("f0134_contiguity: T0=%a, tk_uv_contiguity(UV=%a,A=%a,Base_Beta=%a);\n",T0,UV,A,Base_Beta);

  if (type(getopt(b_ideal))>0) {
    printf("b_ideal option is on.\n");
    return map(f0134_contiguity_red,T0,A,Base_Beta,Beta_start,Beta_target,UV);
  }else{
    return f0134_contiguity_red(T0,A,Base_Beta,Beta_start,Beta_target,UV);
  }
}

def f0134_contiguity_red(Cont,A,Base_Beta,Beta_start,Beta_target,UV) {
  XL = base_var_list(x,1,length(A[0])); Dx = poly_dvar(XL); 
  if (Cont==0) {
    printf("Warning! No contiguity is found. Return 0.\n");
    return 0;
  }else{ }
  B_dxv = Cont[0]; E = Cont[1];
  printf("B_dxv=%a\n",fctr(B_dxv));
    
  Removed_var = base_set_minus(XL, [x3,x4]); // change here
  E2 = base_replace(E, at_one_rule(Removed_var));
  Witness = newvect(length(A));
  E2_elim = lr_red(E2, A, XL, Beta_start, Witness);

  printf("checking the result...\n");
  check_contiguity_f0134(E2_elim,Beta_target,Beta_start | prob=1);
  printf("... Done\n");
    
  return [E2_elim, red(B_dxv/v2mon(Dx,UV[1])), [Beta_start, " -> ", Beta_target], [E, B_dxv, v2mon(Dx,UV[0]), v2mon(Dx,UV[1])],1];
}

def f0134_get_chi(Old,New) {
  Os1=-Old[0]; Os2=Old[1]-1; 
  Ns1=-New[0]; Ns2=New[1]-1; 
  Chi=[Ns1-Os1,Ns2-Os2];
  return Chi;
}

// return [b-ideal, Old->New contiguity str not restricted]
def f0134_b_ideal_sp(Old,New) {
  A = F0134_A;
  Amat=matrix_list_to_matrix(A);
  Beta_start=param_to_beta1(Old);  // change here
  Beta_target=param_to_beta1(New); // change here
  Chi=vtol(ltov(Beta_target)-ltov(Beta_start));
  UV=tk_chi_to_uv(A,Chi);
  printf("Chi=%a, UV=%a\n",Chi,UV);
  Base_Beta=ltov(Beta_start)+Amat*ltov(UV[0]);
  Base_Beta=vtol(Base_Beta);
  T0=tk_uv_contiguity(UV,A,Base_Beta | b_ideal=1);  // change here
  printf("T0=%a, tk_uv_contiguity(%a,%a,%a);\n",T0,UV,A,Base_Beta);
  printf("length(T0)=%a > 1 ?\n",length(T0));
  Dxv=tk_v_to_monomial(base_var_list(dx,1,length(A[0])),UV[1]); // これが必要.
  B=[];
  for (I=0; I<length(T0); I++) {
    B=cons(red(T0[I][0]/Dxv),B); // change here
  }
  return [reverse(B),T0]; //change here
}
// return [b-ideal, Old->New contiguity str not restricted, New->Old contiguity str not restricted]
def f0134_isom_sp(Old,New) {
  B1=f0134_b_ideal_sp(Old,New); // change here
  B2=f0134_b_ideal_sp(New,Old); // change here
  Id1=B1[0]; Id2=B2[0];
  Id=[];   // Id1 \cap Id2, V(Id1) \cup V(Id2)
  for (I=0; I<length(Id1); I++) {
    for (J=0; J<length(Id2); J++) {
      F=Id1[I]*Id2[J];
      if (F != 0) Id=cons(F,Id);
    }
  }
  return [reverse(Id),B1[1],B2[1]];
}


def param_to_beta1(Param) {
  [Param[0],Param[1]];
}

def f0134(Param) {
  A = F0134_A;
//  F=mt_gkz.gkz_b(A,[b1,b2],[1,2]);
//  F=map(dp_dtop,F,[dx3,dx4]);
  F=tk_gkz_b(A,[b1,b2]);
  printf("tk_gkz_b = %a\n",F);
  Beta=param_to_beta1(Param);
  F=base_replace(F,assoc([b1,b2],Beta));
  return F;
}

def f0134_orig(Param) {
  A=F0134_A;
  F=sm1.gkz([A,[b1,b2]]);
  V=F[1]; DV=poly_dvar(V);
  Beta=param_to_beta1(Param);
  F=base_replace(F[0],assoc([b1,b2],Beta));
  F=base_replace(F,[[x1,x1+1],[x2,x2+1]]);
  if (vars(Beta)==[]) {
    H=nk_restriction.restriction_ideal(F,V,DV,[1,1,0,0]);
  }else{
    H=nk_restriction.restriction_ideal(F,V,DV,[1,1,0,0] | param=vars(Beta));
  }
  return H;
}


/*
  I(Left_param) E_final  \subseteq I(Right_param) ?
*/

def check_contiguity_f0134(E_final,Left_param,Right_param) {
  if (type(getopt(prob))>0) {
    if (getopt(prob)==2) Rule=[[b1,13],[b2,3]];
    else Rule=[[b1,random()%100],[b2,random()%30]];
    printf("Warning! using a probabilistic method by specializing params. Rule=%a\n",Rule);
    E_final=base_replace(E_final,Rule);
    Left_param=base_replace(Left_param,Rule);
    Right_param=base_replace(Right_param,Rule);
  }
  V456=[x3,x4];
  Vd456=append(V456,poly_dvar(V456));
  Den=dn(E_final);
  if (length(base_intersection(vars(Den),V456)) > 0) {
    error("check_contiguity: Denominator of E_final contains x3, x4");
  }
  if (E_final==0) error("E_final==0");
  E_final=nm(E_final);
  // =========================================================
  // 正当性の確認: 元の Beta のイデアルで検証
  // =========================================================
  printf("Verifying L * E_final mod Gb_rest (Beta) == 0 ...\n");
  SymL=f0134(Left_param);
  SymR=f0134(Right_param);
  Gb_rest_base = nd_weyl_gr(SymR, Vd456, 0, 0);
    
  Check_ok = 1;
  for (I = 0; I < length(SymL); I++) {
    L_check = SymL[I];
    Check_prod = poly_dmul(L_check, E_final, V456);
    printf("L_check=%a, E_final=%a, Check_prod=%a, Gb_rest_base=%a\n",L_check,E_final, Check_prod, Gb_rest_base);
    Rem = tk_p_weyl_true_nf(Check_prod, Gb_rest_base, Vd456, 0);
    if (Rem[0] != 0) {
      Check_ok = 0;
      printf("Verification FAILED for generator index %a:\n%a\n", I, Rem[0]/Rem[1]);
      if (Banana_debug >= 10) debug();
    }
  }
    
  if (Check_ok == 1) {
    printf("Verification PASSED: All generators successfully reduced to 0.\n");
  }
}

// mt_gkz.gkz_b は bug あり
// by gemini, 2026.08.28.  tk_gkz_b の実装.
// 単項式 dx_1^e_1 ... dx_n^e_n を Weyl 代数として評価するヘルパー関数
// D: 制限対象となる変数の境界 (I < D なら L_i(L_i-1)... の積にする)
def tk_weyl_eval_term(Coef, ExpV, Subs, V_space, D) {
  //printf("tk_weyl_eval_term(Coef=%a,ExpV=%a,Subs=%a,V_space=%a,D=%a)\n",Coef,ExpV,Subs,V_space,D);
  Ans = Coef;
  N = length(ExpV);
  for (I = 0; I < N; I++) {
    Deg = ExpV[I];
    if (Deg > 0) {
      if (I < D) {
        // x_1 ... x_d の制限変数: L_i * (L_i - 1) * ... * (L_i - Deg + 1)
        for (K = 0; K < Deg; K++) {
          Ans = poly_dmul(Ans, Subs[I] - K, V_space);
        }
      } else {
        // 制限されない変数: dx_i * dx_i * ... 
        for (K = 0; K < Deg; K++) {
          //Ans = poly_dmul(Ans, Subs[I], V_space);  // bug.
          Ans = poly_dmul(Subs[I],Ans, V_space);
        }
      }
    }
  }
  //printf("Ans=%a\n",Ans);
  return Ans;
}

// 多項式(Toric ideal の生成元)全体を Weyl 代数として評価するヘルパー関数
def tk_weyl_eval_poly(P, DX_list, Subs, V_space, D) {
  //printf("tk_weyl_eval_poly(P=%a,DX_list=%a,Subs=%a,V_space=%a,D=%a)\n",P,DX_list,Subs,V_space,D);
  DP = dp_ptod(P, DX_list);
  Ans = 0;
  while (DP != 0) {
    Coef = dp_hc(DP);
    ExpV = dp_etov(dp_ht(DP));
    Term = tk_weyl_eval_term(Coef, ExpV, Subs, V_space, D);
    Ans += Term;
    DP = dp_rest(DP);
  }
  return Ans;
}

// GKZ系を制限したHorn系を計算するメイン関数 (poly_toric_ideal 使用 & 下降階乗積 対応版)
def tk_gkz_b(A, Beta) {
  // A が行列型(type 6)で渡された場合はリストに変換する
  A_list = (type(A) == 6) ? matrix_matrix_to_list(A) : A;
  D = length(A_list);
  N = length(A_list[0]);

  FirstIndex= base_makelist(k,k,0,D-1);
  Epart=matrix_transpose(matrix_submatrix(matrix_transpose(A),FirstIndex));
  if (Epart != matrix_identity_matrix(D)) error("The left part must be identity matrix in tk_gkz_b.");
  
  X = newvect(N);
  DX = newvect(N);
  for (I = 0; I < N; I++) {
    X[I] = eval_str("x" + rtostr(I+1));
    DX[I] = eval_str("dx" + rtostr(I+1));
  }
  DX_list = vtol(DX);
  
  // ==========================================
  // 1. 組み込み関数による Toric Ideal の取得
  // ==========================================
  Toric_ideal = poly_toric_ideal(A_list, DX_list | quiet=1);
  printf("Toric_ideal=%a\n",Toric_ideal);
  
  // ==========================================
  // 2. 制限操作と Weyl 代数での代入式の準備
  // ==========================================
  Subs = newvect(N);
  V_space = [];
  for (I = 0; I < N; I++) {
    if (I < D) {
      // L_i = beta_i - sum(a_{ij} x_j dx_j)
      S_val = Beta[I];
      for (J = D; J < N; J++) {
        S_val = S_val - A_list[I][J]*X[J]*DX[J];
      }
      Subs[I] = S_val;
    } else {
      // 制限外の変数は dx_i をそのまま使う
      Subs[I] = DX[I];
      V_space = cons(X[I], V_space);
    }
  }
  V_space = reverse(V_space);
  
  // ==========================================
  // 3. Toric ideal を Weyl 代数の作用素として評価
  // ==========================================
  Ans = [];
  for (I = 0; I < length(Toric_ideal); I++) {
    Eval_P = tk_weyl_eval_poly(Toric_ideal[I], DX_list, Subs, V_space, D);
    Ans = cons(Eval_P, Ans);
  }
  return reverse(Ans);
}
//Ref: 2026-08-03-banana-contiguity*.goodnoes 2026.08.28

// 実行サンプル
def tk_example_gkz_b() {
  A = [[1, 0, -1],
       [0, 1, 2]];
//  A=[[1,0,-1,-2],[0,1,2,3]];
  DD=length(A); NN=length(A[0]);
  Beta = [beta1, beta2];
  Ans = tk_gkz_b(A, Beta);
  
  printf("Result Horn System generators:\n");
  for (I = 0; I < length(Ans); I++) {
    printf("[%a]: %a\n", I, Ans[I]);
  }
  V=base_var_list(x,DD+1,NN); DV=poly_dvar(V);
  G=nd_weyl_gr(Ans,append(V,DV),0,0);
  return G;
}

