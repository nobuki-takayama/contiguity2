/* 
 c1f1_contiguity(Old,New); は c1f1_from_a_shift([a,c],[a+1,c]);  
 c1f1_isom(Chi);
*/

import("2026-08-05-contiguity.rr");;
//import("symeq_one_loop.rr");; // symeq_one_loop 専用の check_contiguity
import("tk_weyl.rr");;  // called by check_contiguity only
import("linear_poly.rr");;

