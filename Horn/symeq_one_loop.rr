// 完全な LR-reduction   one-loop (n=2) 専用. 2026.08.06 16:19 追加
// bug あり. cf. 2026-08-08,  対応の goodnotes と .md を見よ.
def tk_lr_red_restriction_1_buggy(L, Rule_x, L_rule) {
    local V, D, Vd, MayReducible, L1, C, E_vec, Term, Mon_rec, Ord_orig, L_new;
    
    Ord_orig = dp_ord();
    dp_ord(0);
    
    V = [x1, x2, x3, x4, x5, x6];
    D = [dx1, dx2, dx3, dx4, dx5, dx6];
    Vd = append(V, D);
    
    MayReducible = 1;
    while (MayReducible) {
        MayReducible = 0;
        L = base_replace(L, Rule_x);
        L1 = dp_ptod(L, Vd);
        L_new = 0;
        
        while (L1 != 0) {
            C = dp_hc(L1);
            E_vec = dp_etov(dp_ht(L1));
            
            if (E_vec[6] > 0) {
                MayReducible = 1;
                E_vec[6] = E_vec[6] - 1;
                Mon_rec = dp_dtop(dp_vtoe(E_vec), Vd);
                Term = poly_dmul(C * Mon_rec, L_rule[0], V);
                L_new = L_new + Term;
            } else if (E_vec[7] > 0) {
                MayReducible = 1;
                E_vec[7] = E_vec[7] - 1;
                Mon_rec = dp_dtop(dp_vtoe(E_vec), Vd);
                Term = poly_dmul(C * Mon_rec, L_rule[1], V);
                L_new = L_new + Term;
            } else if (E_vec[8] > 0) {
                MayReducible = 1;
                E_vec[8] = E_vec[8] - 1;
                Mon_rec = dp_dtop(dp_vtoe(E_vec), Vd);
                Term = poly_dmul(C * Mon_rec, L_rule[2], V);
                L_new = L_new + Term;
            } else {
                Mon_rec = dp_dtop(dp_vtoe(E_vec), Vd);
                L_new = L_new + C * Mon_rec;
            }
            L1 = dp_rest(L1);
        }
        L = L_new;
    }
    dp_ord(Ord_orig);
    return L;
}

// 2026.08.07  
def check_contiguity_in_rational_weyl_algebra(E_final,Left_param,Right_param) {

  // probabilistic method
  if (type(getopt(prob))>0) {
    printf("Warning! using a probabilistic method by specializing params.\n");
    Rule=[[d,13],[nu1,3],[nu2,5]];
    E_final=base_replace(E_final,Rule);
    Left_param=base_replace(Left_param,Rule);
    Right_param=base_replace(Right_param,Rule);
  }
  

  V456=[x4,x5,x6];
  Vd456=append(V456,D456=poly_dvar(V456));
  Den=dn(E_final);
  if (length(base_intersection(vars(Den),V456)) > 0) {
    error("check_contiguity: Denominator of E_final contains x4,x5,x6");
  }
  E_final=nm(E_final);
  // =========================================================
  // 正当性の確認: 元の Beta のイデアルで検証
  // =========================================================
  printf("Verifying L * E_final mod Gb_rest (Beta) == 0 in rational Weyl algebra\n");
  SymL=symeq_one_loop(Left_param);
  SymR=symeq_one_loop(Right_param);
  yang.define_ring(["partial",V456]);
  dp_ord(0);
  Gb_rest_base = yang.buchberger(map(dp_ptod,SymR,D456));
  //print(Gb_rest_base);
    
  Check_ok = 1;
  for (I = 0; I < length(SymL); I++) {
    L_check = SymL[I];
    Check_prod = poly_dmul(L_check, E_final, V456);
    Rem = yang.reduction(dp_ptod(Check_prod,D456), Gb_rest_base);
    if (Rem[0] != 0) {
      Check_ok = 0;
      printf("Verification FAILED for generator index %a:\nRem=%a", I,Rem);
      if (Banana_debug >=10) debug();
    }
  }
    
  if (Check_ok == 1) {
    printf("Verification PASSED: All generators successfully reduced to 0.\n");
  }
}

