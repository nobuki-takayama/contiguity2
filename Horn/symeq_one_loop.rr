// 2026.08.08
/*
  修正版: 1-loop banana 用手動 LR reduction
  Weyl 代数の交換関係 ( -x_i*dx_i 由来 ) を厳密に処理する
*/

// 完全な LR-reduction (修正版)
def tk_lr_red_restriction_1(L, Rule_x, L_rule) {
    local V, D, Vd, MayReducible, L1, C, E_vec, Term, Mon_rec, Ord_orig, L_new;
    
    Ord_orig = dp_ord();
    dp_ord(0);
    
    // poly_dmul に渡す空間変数のリスト
    V = [x1, x2, x3, x4, x5, x6];
    D = [dx1, dx2, dx3, dx4, dx5, dx6];
    Vd = append(V, D);
    
    MayReducible = 1;
    // 最初の置換 (x1,x2,x3 に 1 を代入し、b1等を Beta に置換)
    L = base_replace(L, Rule_x);
    
    while (MayReducible) {
        MayReducible = 0;
        L1 = dp_ptod(L, Vd);
        L_new = 0;
        
        while (L1 != 0) {
            C = dp_hc(L1);
            E_vec = dp_etov(dp_ht(L1));
            
            if (E_vec[6] > 0) { // dx1 を右から1つ消去
                MayReducible = 1;
                E_vec[6] = E_vec[6] - 1;
                Mon_rec = dp_dtop(dp_vtoe(E_vec), Vd);
                // Weyl 代数での積を展開 (-x1*dx1 などが含まれる)
                Term = poly_dmul(C * Mon_rec, L_rule[0], V);
                // 展開後、ただちに x1=0, x2=0, x3=0 に制限する
                Term = base_replace(Term, [[x1, 0], [x2, 0], [x3, 0]]);
                L_new = L_new + Term;
            } else if (E_vec[7] > 0) { // dx2 を右から1つ消去
                MayReducible = 1;
                E_vec[7] = E_vec[7] - 1;
                Mon_rec = dp_dtop(dp_vtoe(E_vec), Vd);
                Term = poly_dmul(C * Mon_rec, L_rule[1], V);
                Term = base_replace(Term, [[x1, 0], [x2, 0], [x3, 0]]);
                L_new = L_new + Term;
            } else if (E_vec[8] > 0) { // dx3 を右から1つ消去
                MayReducible = 1;
                E_vec[8] = E_vec[8] - 1;
                Mon_rec = dp_dtop(dp_vtoe(E_vec), Vd);
                Term = poly_dmul(C * Mon_rec, L_rule[2], V);
                Term = base_replace(Term, [[x1, 0], [x2, 0], [x3, 0]]);
                L_new = L_new + Term;
            } else {
                // dx1, dx2, dx3 を含まない項はそのまま足す
                Mon_rec = dp_dtop(dp_vtoe(E_vec), Vd);
                L_new = L_new + C * Mon_rec;
            }
            L1 = dp_rest(L1);
        }
        L = L_new;
    }
    dp_ord(Ord_orig);
    return L;
}

// -------------------------------------------------------------
// 【呼び出し側の修正】 L_rule に -x_i*dx_i を明示的に追加する
// -------------------------------------------------------------
def tk_example_caller(Beta_start, E_orig) {
    local Rule_x, L_rule, E_lr;

    Rule_x = [[x1, 1], [x2, 1], [x3, 1], [b1, Beta_start[0]], [b2, Beta_start[1]], [b3, Beta_start[2]]];
    
    // 修正箇所: 各ルールに元の x_i*dx_i を組み込んでおく
    L_rule = [
        Beta_start[0] - x1*dx1 - x5*dx5 - x6*dx6, 
        Beta_start[1] - x2*dx2 + x5*dx5,
        Beta_start[2] - x3*dx3 + x6*dx6
    ];

    E_lr = tk_lr_red_restriction(E_orig, Rule_x, L_rule);
    
    return E_lr;
}


