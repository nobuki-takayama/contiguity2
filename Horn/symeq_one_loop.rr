// 2026.08.07 E f(beta_start) = f(beta_target) なので I(beta_target) E \subset I(beta_start).  Ref: 2026-08-03-banana-contiguity.goodnotes 2026-08-16
// 2026.08.08 に v1 完成. lr_reduction の bug fix.
import("yang.rr");;
extern Banana_debug;;
Banana_debug=10;;
def symeq_one_loop(Param) {
  if (type(getopt(odd))>=0) Odd=getopt(odd);
  else Odd=-1;
  if (Odd==1) {
    D=2*Param[0]+1; Nu1=Param[1]; Nu2=Param[2];
  }else if (Odd==0) {
    D=2*Param[0]; Nu1=Param[1]; Nu2=Param[2];
  }else{
    D=Param[0]; Nu1=Param[1]; Nu2=Param[2];
  }
    // 物理パラメータに基づく Beta の定義
    B1 = D - Nu1 - Nu2 - 1;
    B2 = Nu1 - D/2;
    B3 = Nu2 - D/2;
    B4 = D/2 - Nu1 - Nu2;
    
    V456 = [x4, x5, x6];
    D456 = [dx4, dx5, dx6];
    Vd456 = append(V456, D456);
    
    Th4 = x4*dx4;
    Th5 = x5*dx5;
    Th6 = x6*dx6;
    
    Vall=[x4,x5,x6];
    Vdall=append(Vall,poly_dvar(Vall));
    // ノートで与えられた制限イデアルの生成元
    F1 = Th4 + Th5 + Th6 - B4;
    F2 = poly_dmul(dx5,(Th5 + B2),Vall) - poly_dmul(dx6,(Th6 + B3),Vall);
    F3 = poly_dmul(dx4,(Th4 + B1 - B4),Vall) - poly_dmul(dx5,(Th5 + B2),Vall);
    A0 = dx5*dx6 + dx4*dx6 + dx4*dx5; 
    return [F1,F2,F3,A0];;
}

/*
  I(Left_param) E_final  \subseteq I(Right_param) ?
*/
def check_contiguity(E_final,Left_param,Right_param) {
  if (nm(E_final)==0) error("E_final==0");
  if (type(getopt(prob))>0) {
    if (getopt(prob)==2) Rule=[[d,13],[nu1,3],[nu2,5],[dp,12]];
    else Rule=[[d,random()%100],[nu1,random()%30],[nu2,random()%33],[dp,random()%100]];
    printf("Warning! using a probabilistic method by specializing params. Rule=%a\n",Rule);
    E_final=base_replace(E_final,Rule);
    Left_param=base_replace(Left_param,Rule);
    Right_param=base_replace(Right_param,Rule);
  }
  V456=[x4,x5,x6];
  Vd456=append(V456,poly_dvar(V456));
  Den=dn(E_final);
  if (length(base_intersection(vars(Den),V456)) > 0) {
    error("check_contiguity: Denominator of E_final contains x4,x5,x6");
  }
  E_final=nm(E_final);
  if (E_final == 0) {
    printf("Warning! E_final==0.\n");
  }else{
    printf("OK. E_final != 0.\n");
  }
  // =========================================================
  // 正当性の確認: 元の Beta のイデアルで検証
  // =========================================================
  printf("Verifying L * E_final mod Gb_rest (Beta) == 0 ...\n");
  SymL=symeq_one_loop(Left_param | option_list=getopt());
  SymR=symeq_one_loop(Right_param | option_list=getopt());
  Gb_rest_base = nd_weyl_gr(SymR, Vd456, 0, 0);
  if (length(Gb_rest_base) < 2) printf("Warning! length(Gb_rest_base) < 2!\n");
    
  Check_ok = 1;
  for (I = 0; I < length(SymL); I++) {
    printf("%a ",I);
    L_check = SymL[I];
    Check_prod = poly_dmul(L_check, E_final, V456);
    if (Check_prod==0) printf("Warning! Check_prod==0.\n");
    Rem = tk_p_weyl_true_nf(Check_prod, Gb_rest_base, Vd456, 0);
    if (Rem[0] != 0) {
      Check_ok = 0;
      printf("Verification FAILED for generator index %a:\n%a\n", I, Rem[0]/Rem[1]);
      if (Banana_debug >= 10) debug();
    }
  }
    
  if (Check_ok == 1) {
    printf("\nVerification PASSED: All generators successfully reduced to 0.\n");
  }
}

def check1() {
  check_contiguity(dx5,[d,nu1+1,nu2],[d,nu1,nu2]);
}
